{
   "version": 3,
   "cmakeMinimumRequired": {
      "major": 3,
      "minor": 21,
      "patch": 0
   },
   "configurePresets": [
      {
         "name": "default",
         "displayName": "Default (Debug) configuration",
         "description": "Debug build using PSn00bSDK with symbols.",
         "generator": "Ninja",
         "toolchainFile": "$env{PSN00BSDK_LIBS}/cmake/sdk.cmake",
         "binaryDir": "/workspace/build",
         "cacheVariables": {
            "CMAKE_BUILD_TYPE": "Debug",
            "PSN00BSDK_TC": "",
            "PSN00BSDK_TARGET": "mipsel-none-elf"
         },
         "warnings": {
            "dev": false
         }
      },
      {
         "name": "release",
         "displayName": "Release configuration",
         "description": "Optimized release build using PSn00bSDK.",
         "generator": "Ninja",
         "toolchainFile": "$env{PSN00BSDK_LIBS}/cmake/sdk.cmake",
         "binaryDir": "/workspace/build",
         "cacheVariables": {
            "CMAKE_BUILD_TYPE": "Release",
            "PSN00BSDK_TC": "",
            "PSN00BSDK_TARGET": "mipsel-none-elf"
         },
         "warnings": {
            "dev": false
         }
      }
   ]
}